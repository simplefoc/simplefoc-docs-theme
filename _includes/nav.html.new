<nav role="navigation" aria-label="Main navigation">
  {%- comment -%}
  Styles for active link + collapsible behavior
  {%- endcomment -%}
  <style>
    /* Active link styling */
    .navigation-list-link.is-active {
      font-weight: 600;
      text-decoration: underline;
    }

    .navigation-list-item.is-active > .navigation-list-link {
      font-weight: 600;
    }

    /* Collapsed submenus */
    .navigation-list-child-list.is-collapsed {
      display: none;
    }

    /* Indicate items with children */
    .navigation-list-item.has-children > .navigation-list-link::after {
      content: "▸";
      font-size: 0.8em;
      margin-left: 0.3em;
    }

    .navigation-list-item.has-children.is-expanded > .navigation-list-link::after {
      content: "▾";
    }
  </style>

  <ul class="navigation-list">
    {%- assign pages_list = site.html_pages | sort:"nav_order" -%}

    {%- comment -%}
    TOP LEVEL (no parent)
    {%- endcomment -%}
    {%- for node in pages_list -%}
      {%- unless node.nav_exclude -%}
        {%- if node.parent == nil -%}
          <li class="navigation-list-item{% if node.has_children %} has-children{% endif %}">
            <a href="{{ node.url | absolute_url }}" class="navigation-list-link">
              {{ node.title }}
            </a>

            {%- if node.has_children -%}
              {%- assign children_list = pages_list | where: "parent", node.title | sort:"nav_order" -%}
              <ul class="navigation-list-child-list" style="list-style-type: none;">
                {%- for child in children_list -%}
                  <li class="navigation-list-item child-list{% if child.has_children %} has-children{% endif %}">
                    <a href="{{ child.url | absolute_url }}" class="navigation-list-link">
                      {{ child.title }}
                    </a>

                    {%- if child.has_children -%}
                      {%- assign grand_children_list = pages_list | where: "parent", child.title | sort:"nav_order" -%}
                      <ul class="navigation-list-child-list" style="list-style-type: none;">
                        {%- for grand_child in grand_children_list -%}
                          <li class="navigation-list-item grand-child-list{% if grand_child.has_children %} has-children{% endif %}">
                            <a href="{{ grand_child.url | absolute_url }}" class="navigation-list-link">
                              {{ grand_child.title }}
                            </a>

                            {%- if grand_child.has_children -%}
                              {%- assign grand_grand_children_list = pages_list | where: "parent", grand_child.title | sort:"nav_order" -%}
                              <ul class="navigation-list-child-list" style="list-style-type: none;">
                                {%- for grand_grand_child in grand_grand_children_list -%}
                                  <li class="navigation-list-item grand-grand-child-list{% if grand_grand_child.has_children %} has-children{% endif %}">
                                    <a href="{{ grand_grand_child.url | absolute_url }}" class="navigation-list-link">
                                      {{ grand_grand_child.title }}
                                    </a>

                                    {%- if grand_grand_child.has_children -%}
                                      {%- assign grand_grand_grand_children_list = pages_list | where: "parent", grand_grand_child.title | sort:"nav_order" -%}
                                      <ul class="navigation-list-child-list" style="list-style-type: none;">
                                        {%- for grand_grand_grand_child in grand_grand_grand_children_list -%}
                                          <li class="navigation-list-item grand-grand-grand-child-list">
                                            <a href="{{ grand_grand_grand_child.url | absolute_url }}" class="navigation-list-link">
                                              {{ grand_grand_grand_child.title }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    {%- endif -%}
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- comment -%}
    External links (unchanged, but no page-dependent logic)
    {%- endcomment -%}
    {%- if site.nav_external_links -%}
      <li class="navigation-list-item external" style="margin-top:10px">
        Additional Resources
        <ul class="navigation-list-child-list" style="list-style-type: none;">
          {%- for node in site.nav_external_links -%}
            <li class="navigation-list-item external">
              <a href="{{ node.url | absolute_url }}" class="navigation-list-link external"
                {% if node.opens_in_new_tab or node.opens_in_new_tab == nil and site.nav_external_links_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              >
                {% unless node.hide_icon %}<i class="fa fa-lg {{ node.fa_icon }}"></i>{% endunless %}
                {{ node.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </li>
    {%- endif -%}
  </ul>
</nav>